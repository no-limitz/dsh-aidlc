{
  "name": "dsh-aidlc",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle that loads AWS AI-DLC (AI-Driven Development Life Cycle) agents, skills, and hooks",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./hooks": {
      "types": "./lib/hooks.d.ts",
      "default": "./lib/hooks.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./preset-root": {
      "types": "./lib/preset-root.d.ts",
      "default": "./lib/preset-root.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "presets/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-hook-protocol": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "aidlc",
    "ai-dlc",
    "aws"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no-limitz/dsh-aidlc.git"
  }
}
